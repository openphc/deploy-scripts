# Grafana
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=
# Credentials for Grafana's provisioned data-pipeline datasources (ClickHouse + read-only Postgres).
# Both are mandatory — docker-compose fails fast if unset.
CLICKHOUSE_PASSWORD=
POSTGRES_READ_ONLY_PASSWORD=

# cce-compliance-service
KEYCLOAK_ISSUER_URI=

# cce-intelligence-service (RI-63 ops-alerting engine — demo-rw branch)
CCE_INTELLIGENCE_SMTP_HOST=smtp.gmail.com
CCE_INTELLIGENCE_SMTP_PORT=587
CCE_INTELLIGENCE_SMTP_USERNAME=
CCE_INTELLIGENCE_SMTP_PASSWORD=
# Tier recipients — named by tier position, not by whoever currently holds it. Each accepts one
# address or a comma-separated list. All required — the service fails to start otherwise.
CCE_INTELLIGENCE_ALERT_EMAIL_TIER1=
CCE_INTELLIGENCE_ALERT_NAME_TIER1=
CCE_INTELLIGENCE_ALERT_EMAIL_TIER2=
CCE_INTELLIGENCE_ALERT_NAME_TIER2=
CCE_INTELLIGENCE_ALERT_EMAIL_TIER3=
CCE_INTELLIGENCE_ALERT_NAME_TIER3=
# Escalation-timing — required, no default (matching the recipients above, wired the same plain
# way, not the app's own PRD-matching fallback the other optional vars below get): a missing
# value fails the pod at startup with a clear, precise error of its own naming exactly which one
# — not silently masked by a typo'd key or a forgotten entry on a new environment. PRD values
# shown below — change only if this environment genuinely needs different thresholds.
CCE_OPSALERT_TIER1_THRESHOLD_MINUTES=240
CCE_OPSALERT_TIER2_THRESHOLD_MINUTES=1440
CCE_OPSALERT_TIER3_THRESHOLD_MINUTES=2880

# Fully-silent kill switch — false skips the scheduled tick entirely (no evaluation, no tracker
# state, nothing sent), not just a mute on delivery. Defaults to true (running) at the app level
# if left unset here. See cce-intelligence-service's api-reference.md, "Operational controls".
CCE_OPSALERT_NOTIFICATIONS_ENABLED=true

# Resends the last tier's email every this-many minutes (from whichever send most recently
# happened) once escalation reaches it, until the incident resolves. Defaults to 1440 (24h — on
# by default, not off) at the app level if left unset here; set <= 0 to disable repeating.
CCE_OPSALERT_REPEAT_INTERVAL_MINUTES=1440

# Tier Cc — optional, comma-separated for more than one address per tier. Wired as a plain
# passthrough for all three: every tier's app-level default is the same, empty (no built-in
# escalation chain — cc'ing an earlier tier's recipient means listing that address explicitly).
CCE_OPSALERT_TIER1_CC=
CCE_OPSALERT_TIER2_CC=
CCE_OPSALERT_TIER3_CC=

# Still not wired anywhere yet — these are meant to stay optional, since the app's own
# PRD-matching default is genuinely fine to fall back to. See docker-compose.yml's comment for
# what wiring one of these correctly requires.
# CCE_OPSALERT_POLL_INTERVAL_MS=
# CCE_OPSALERT_TIER1_SUBJECT=
# CCE_OPSALERT_TIER2_SUBJECT=
# CCE_OPSALERT_TIER3_SUBJECT=

KEYCLOAK_JWK_SET_URI=