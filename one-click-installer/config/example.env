# ════════════════════════════════════════════════════════════════════════════════════════════════════
#  CCE one-click installer — deployment configuration
#
#  Copy this file to config/<envcode>.env, edit, then:
#      sudo bash one-click-installer/install.sh --config one-click-installer/config/<envcode>.env
#
#  NO SECRETS here. Passwords/tokens live in Infisical (generated by the installer, or supplied once via SEED_ENV_FILE,
#  which should sit OUTSIDE the repo). config/*.env is gitignored except this example.
#  Any key can also be supplied as an environment variable; the environment wins over this file.
# ════════════════════════════════════════════════════════════════════════════════════════════════════

# ── Environment identity ───────────────────────────────────────────────────────────────────────────
# Short lowercase code: becomes the k3s namespace cce-<ENVCODE> and the Infisical project cce-<ENVCODE>.
ENVCODE=dev
# Directory under k8s/overlays/ to create (default: ENVCODE). Must differ from OVERLAY_TEMPLATE — e.g. ENVCODE=prod needs
# OVERLAY_NAME=<country>-prod.
OVERLAY_NAME=
# The overlay cloned as the starting point (resource sizing, HPAs, rate limits, patches). The reference production overlay.
OVERLAY_TEMPLATE=prod

# ── Public access ──────────────────────────────────────────────────────────────────────────────────
# DNS name that points at this machine. Empty = plain HTTP on the machine's address (no TLS) — fine for a trial.
INGRESS_HOST=
# Required when INGRESS_HOST is set: Let's Encrypt contact for the TLS certificate.
ACME_EMAIL=

# ── Hosting / network security ─────────────────────────────────────────────────────────────────────
# true  = cloud VM behind the provider's security group / firewall (AWS SG, Azure NSG, GCP firewall…): host firewall NOT configured.
# false = on-prem / bare metal / a VM directly on the internet: the installer configures UFW (default-deny; only 22/80/443 public).
# Either way, ports published by Docker are blocked from the public NIC (they bypass UFW and cloud SGs can be misconfigured).
IS_CLOUD_DEPLOYMENT=false
# Optional (IS_CLOUD_DEPLOYMENT=false): restrict SSH to an admin network, e.g. 196.12.0.0/16. Empty = SSH open to all.
SSH_ALLOWED_CIDR=
# Optional extra public allows, comma-separated UFW rules, e.g. "8443/tcp,10.20.0.0/16".
UFW_EXTRA_ALLOW=

# ── Secrets store (Infisical) ──────────────────────────────────────────────────────────────────────
# true  = run a self-contained Infisical on this machine (127.0.0.1:8080), created and logged into automatically.
# false = use an existing Infisical at INFISICAL_DOMAIN; export INFISICAL_ADMIN_EMAIL / INFISICAL_ADMIN_PASSWORD (org admin)
#         in the environment before running — never put them in this file.
USE_LOCAL_INFISICAL=true
INFISICAL_DOMAIN=http://localhost:8080
# Optional KEY=value file of initial values (e.g. passwords you want instead of generated ones, OpenHIM settings).
# Keep it OUTSIDE the repo. Empty = everything generated/defaulted; external-system settings left blank to fill in later.
# REQUIRED in it (intelligence-service will not start without them): CCE_INTELLIGENCE_SMTP_HOST / _USERNAME / _PASSWORD and
# CCE_INTELLIGENCE_ALERT_EMAIL_TIER1..3 + CCE_INTELLIGENCE_ALERT_NAME_TIER1..3. Ops-alert e-mails start disabled
# (CCE_OPSALERT_NOTIFICATIONS_ENABLED=false) — set it to true in Infisical once the environment is live.
SEED_ENV_FILE=

# ── Keycloak login theme ───────────────────────────────────────────────────────────────────────────
# Directory (repo-relative or absolute) holding login/theme.properties. Default = the unbranded CCE theme; point it at a
# country-branded copy (e.g. keycloak-themes/insights-ui-theme, Rwanda's) to brand the login page.
KEYCLOAK_THEME_DIR=keycloak-themes/cce-insights-theme/dev

# ── Platform versions (defaults = what the reference production environment runs) ──────────────────
K3S_VERSION=v1.35.4+k3s1
INFISICAL_CLI_VERSION=0.43.93
# Series ("26.5" = newest 26.5.x) or exact version. Keep on 26.5 unless the analytics schema has been made 26.10-compatible:
# ClickHouse >= 26.10 rejects data-pipeline/schema/03-create-materialized-views.sql.
CLICKHOUSE_VERSION=26.5
POSTGRES_VERSION=16
KAFKA_VERSION=3.7.0
DEBEZIUM_VERSION=3.0.0.Final
# Query statistics for the Grafana Postgres dashboards (preloaded library; one Postgres restart, at install time only).
ENABLE_PG_STAT_STATEMENTS=true

# ── CCE service images ─────────────────────────────────────────────────────────────────────────────
# Each value is a TAG (release-1.2.0) or an exact DIGEST (sha256:…, strongest — what you tested is what runs).
# Empty = keep the template overlay's value. IMAGE_TAG_DEFAULT applies to every service left empty below.
# IMAGE_REGISTRY replaces the registry/owner of every image (e.g. an in-country mirror: registry.example.org/cce).
IMAGE_REGISTRY=
IMAGE_TAG_DEFAULT=
IMAGE_CCE_COLLECTOR_SERVICE=
IMAGE_CCE_PROTOCOL_SERVICE=
IMAGE_CCE_MATCHER_SERVICE=
IMAGE_CCE_STEP_SLA_SERVICE=
IMAGE_CCE_INTELLIGENCE_SERVICE=
IMAGE_CCE_INSIGHTS_SERVICE=
IMAGE_CCE_INSIGHTS_UI=
IMAGE_GATEWAY_SERVICE=
# The emitter adaptor for this implementation's source system (openhim-, openmrs-, tiberbu-cce-emitter-adaptor …) — whichever
# one the overlay deploys. It strips clinical data before it reaches CCE: pin a build that includes redaction.
# (Overlay with more than one emitter: use each one's own key instead, e.g. IMAGE_OPENHIM_CCE_EMITTER_ADAPTOR.)
IMAGE_CCE_EMITTER_ADAPTOR=

# ── Data pipeline version (ClickHouse schema, CDC publication, Debezium connector, Grafana dashboards) ─────────────
# Not an image: SQL + config. Empty = the copy vendored in this repo's data-pipeline/ (tested with this installer;
# currently cce-data-pipeline demo-v2). Set a branch, tag or full commit SHA to deploy that version of DATA_PIPELINE_REPO
# instead — it is synced into data-pipeline/ (review/commit it, like the overlay). Must match the service versions above.
DATA_PIPELINE_REF=
DATA_PIPELINE_REPO=https://github.com/openphc/cce-data-pipeline.git

# ── Clinical protocol (optional) ───────────────────────────────────────────────────────────────────
# FHIR R4 PlanDefinition JSON for THIS implementation, loaded after install. Needs PROTOCOL_AUTH='Bearer <token>' with
# COMPLIANCE_WRITE in the ENVIRONMENT (a credential — never in this file). Empty = skip; load later.
# Since 2.0 the endpoint is on the protocol service: https://<INGRESS_HOST>/v1/protocol/protocol-definitions
PROTOCOL_FILE=
PROTOCOL_LOAD_URL=
