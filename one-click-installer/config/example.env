# ════════════════════════════════════════════════════════════════════════════════════════════════════
#  CCE one-click installer — deployment configuration
#
#  Copy this file to config/<envcode>.env, edit, then:
#      sudo bash one-click-installer/install.sh --config one-click-installer/config/<envcode>.env
#
#  NO SECRETS here. Passwords/tokens live in Infisical (generated by the installer, or supplied once via SEED_ENV_FILE,
#  which should sit OUTSIDE the repo). config/*.env is gitignored except this example.
#  Any key can also be supplied as an environment variable; the environment wins over this file.
# ════════════════════════════════════════════════════════════════════════════════════════════════════

# ── Environment identity ───────────────────────────────────────────────────────────────────────────
# Short lowercase code: becomes the k3s namespace cce-<ENVCODE> and the Infisical project cce-<ENVCODE>.
ENVCODE=dev
# Directory under k8s/overlays/ to create (default: ENVCODE). Must differ from OVERLAY_TEMPLATE — e.g. ENVCODE=prod needs
# OVERLAY_NAME=<country>-prod.
OVERLAY_NAME=
# The overlay cloned as the starting point (resource sizing, HPAs, rate limits, patches). The reference production overlay.
OVERLAY_TEMPLATE=prod

# ── Public access ──────────────────────────────────────────────────────────────────────────────────
# DNS name that points at this machine; with it, Traefik gets a Let's Encrypt certificate and serves HTTPS.
# Empty = plain HTTP on the machine's address (no TLS): APIs and Grafana work, but Insights sign-in does not (browsers give
# the Keycloak login its Web Crypto API on HTTPS or localhost only). No DNS of your own: use
# <ip-with-dashes>.sslip.io (e.g. 13-235-174-187.sslip.io), which resolves to that IP.
INGRESS_HOST=
# Required when INGRESS_HOST is set: Let's Encrypt contact for the TLS certificate.
ACME_EMAIL=

# ── Hosting / network security ─────────────────────────────────────────────────────────────────────
# true  = cloud VM behind the provider's security group / firewall (AWS SG, Azure NSG, GCP firewall…): host firewall NOT configured.
# false = on-prem / bare metal / a VM directly on the internet: the installer configures UFW (default-deny; only 22/80/443 public).
# Either way, ports published by Docker are blocked from the public NIC (they bypass UFW and cloud SGs can be misconfigured).
IS_CLOUD_DEPLOYMENT=false
# Optional (IS_CLOUD_DEPLOYMENT=false): restrict SSH to an admin network, e.g. 196.12.0.0/16. Empty = SSH open to all.
SSH_ALLOWED_CIDR=
# Optional extra public allows, comma-separated UFW rules, e.g. "8443/tcp,10.20.0.0/16".
UFW_EXTRA_ALLOW=

# ── Secrets store (Infisical) ──────────────────────────────────────────────────────────────────────
# true  = run a self-contained Infisical on this machine (127.0.0.1:8080), created and logged into automatically. By default it is
#         installed NATIVELY (infisical-core package + Redis + a database in the native PostgreSQL — LOCAL_INFISICAL_RUNTIME=native);
#         LOCAL_INFISICAL_RUNTIME=docker runs the older docker-compose one. An existing docker one is migrated to native automatically.
# false = use an existing Infisical at INFISICAL_DOMAIN; export INFISICAL_ADMIN_EMAIL / INFISICAL_ADMIN_PASSWORD (org admin)
#         in the environment before running — never put them in this file.
USE_LOCAL_INFISICAL=true
INFISICAL_DOMAIN=http://localhost:8080
LOCAL_INFISICAL_RUNTIME=native
# Native package version (apt, held). Must not be older than the version that wrote an existing database.
INFISICAL_CORE_VERSION=0.162.24-1
# Optional KEY=value file of initial values (e.g. passwords you want instead of generated ones, OpenHIM settings).
# Keep it OUTSIDE the repo. Empty = everything generated/defaulted; external-system settings left blank to fill in later.
# REQUIRED in it (intelligence-service will not start without them): CCE_INTELLIGENCE_SMTP_HOST / _USERNAME / _PASSWORD and
# CCE_INTELLIGENCE_ALERT_EMAIL_TIER1..3 + CCE_INTELLIGENCE_ALERT_NAME_TIER1..3. Ops-alert e-mails start disabled
# (CCE_OPSALERT_NOTIFICATIONS_ENABLED=false) — set it to true in Infisical once the environment is live.
SEED_ENV_FILE=

# ── Portainer (optional management UI) ─────────────────────────────────────────────────────────────
# true = the native Portainer server (release binary, systemd service cce-portainer) + its agent in k3s. HTTPS 9443, reachable only
# from this host and the k3s networks — use an SSH tunnel: ssh -L 9443:localhost:9443 <user>@<host>, then https://localhost:9443.
# Admin "admin", password in Infisical /portainer PORTAINER_ADMIN_PASSWORD (or preset it in SEED_ENV_FILE, min 12 characters).
PORTAINER_ENABLED=true
PORTAINER_VERSION=2.39.2

# ── Keycloak login theme ───────────────────────────────────────────────────────────────────────────
# Directory (repo-relative or absolute) holding login/theme.properties. Default = the unbranded CCE theme; point it at a
# country-branded copy (e.g. keycloak-themes/insights-ui-theme, Rwanda's) to brand the login page.
KEYCLOAK_THEME_DIR=keycloak-themes/cce-insights-theme/dev

# ── Platform versions (defaults = what the reference production environment runs) ──────────────────
K3S_VERSION=v1.35.4+k3s1
INFISICAL_CLI_VERSION=0.43.93
# Series ("26.5" = newest 26.5.x) or exact version. Keep on 26.5 unless the analytics schema has been made 26.10-compatible:
# ClickHouse >= 26.10 rejects data-pipeline/schema/03-create-materialized-views.sql.
CLICKHOUSE_VERSION=26.5
POSTGRES_VERSION=16
# Kafka + Kafka Connect. 3.9.2 (not 3.7.0, the reference PROD): fixes CVE-2025-27817/-27818 in Connect. Raising it on an existing
# machine upgrades Kafka in place on the next run (one-click-installer/lib/native/setup-postgres-kafka.sh; data kept, old install kept as rollback).
KAFKA_VERSION=3.9.2
DEBEZIUM_VERSION=3.0.0.Final
# Prometheus exporters for the native Postgres and Kafka: systemd (default — pinned, checksum-verified release binaries as host
# services, no container) or docker (`docker run --network host`). POSTGRES_/KAFKA_EXPORTER_VERSION (+ _SHA256) override the pins.
EXPORTER_RUNTIME=systemd
# Query statistics for the Grafana Postgres dashboards (preloaded library; one Postgres restart, at install time only).
ENABLE_PG_STAT_STATEMENTS=true

# ── CCE service images ─────────────────────────────────────────────────────────────────────────────
# Each value is a TAG (release-1.2.0) or an exact DIGEST (sha256:…, strongest — what you tested is what runs).
# Empty = keep the template overlay's value. IMAGE_TAG_DEFAULT applies to every service left empty below.
# IMAGE_REGISTRY replaces the registry/owner of every image (e.g. an in-country mirror: registry.example.org/cce).
IMAGE_REGISTRY=
IMAGE_TAG_DEFAULT=
IMAGE_CCE_COLLECTOR_SERVICE=
IMAGE_CCE_PROTOCOL_SERVICE=
IMAGE_CCE_MATCHER_SERVICE=
IMAGE_CCE_STEP_SLA_SERVICE=
IMAGE_CCE_INTELLIGENCE_SERVICE=
# Insights is built per branch: demo-dev-* (the default here: unbranded, step groups), demo-rw-* (Rwanda), demo-tiberbu-*,
# latest / v<N> (main). demo-dev needs the step-group data pipeline (cce-data-pipeline demo-v2) and Matcher V8.
# For production pin an exact build: demo-dev-v<N> or a sha256: digest. Empty = the template's demo-dev-latest.
IMAGE_CCE_INSIGHTS_SERVICE=demo-dev-latest
IMAGE_CCE_INSIGHTS_UI=demo-dev-latest
IMAGE_GATEWAY_SERVICE=
# The image of the emitter adaptor chosen with EMITTER_ADAPTOR below (openhim-, tiberbu-cce-emitter-adaptor …).
# It strips clinical data before it reaches CCE: pin a build that includes redaction.
# (Overlay with more than one emitter: use each one's own key instead, e.g. IMAGE_OPENHIM_CCE_EMITTER_ADAPTOR.)
IMAGE_CCE_EMITTER_ADAPTOR=

# ── Emitter adaptor (the source system feeding CCE) ────────────────────────────────────────────────
# Which <system>-cce-emitter-adaptor to deploy: any k8s/emitters/<name>/ (today: openhim, tiberbu).
# The source system posts events to https://<INGRESS_HOST>/v1/<name>-emitter-adaptor/inbound with HTTP Basic credentials:
# user EMITTER_INBOUND_USER (default <name>-emitter-inbound), password EMITTER_INBOUND_PASSWORD — generated into Infisical
# /keycloak at install; read it with lib/infisical-run.sh <envcode> printenv EMITTER_INBOUND_PASSWORD (or set your own in
# SEED_ENV_FILE before the first install). Changing EMITTER_ADAPTOR later: edit it here and re-run install.sh.
EMITTER_ADAPTOR=openhim

# ── Data pipeline version (ClickHouse schema, CDC publication, Debezium connector, Grafana dashboards) ─────────────
# Not an image: SQL + config. A branch, tag or full commit SHA of DATA_PIPELINE_REPO: the installer fetches it into
# data-pipeline/ on every run (data-pipeline/.deployed-ref records the commit). Must match the service versions above;
# demo-v2 = step groups (Matcher V8) with 200-day ClickHouse retention. Pin a commit SHA for a reproducible install.
# Empty = use a data-pipeline/ already in this repository (branches that keep a copy; release-2.0.0 does not).
DATA_PIPELINE_REF=demo-v2
DATA_PIPELINE_REPO=https://github.com/openphc/cce-data-pipeline.git

# ── Clinical protocol (optional) ───────────────────────────────────────────────────────────────────
# FHIR R4 PlanDefinition JSON for THIS implementation, loaded after install. Needs PROTOCOL_AUTH='Bearer <token>' with
# COMPLIANCE_WRITE in the ENVIRONMENT (a credential — never in this file). Empty = skip; load later.
# Since 2.0 the endpoint is on the protocol service: https://<INGRESS_HOST>/v1/protocol/protocol-definitions
PROTOCOL_FILE=
PROTOCOL_LOAD_URL=

# ── Advanced (optional — the defaults shown are what an unset key means) ──────────────────────────
# k3s networks. Change them only if 10.42/10.43 clash with the site's own network; they take effect when k3s is FIRST
# installed (also used for Postgres access, the firewall and Portainer). An existing cluster keeps its networks.
# K3S_CLUSTER_CIDR=10.42.0.0/16
# K3S_SERVICE_CIDR=10.43.0.0/16
# Where the Infisical machine-identity files (<envcode>.creds/.meta, root-only) are kept. Default: ~/.cce-infisical of the
# user who ran sudo.
# CCE_INFISICAL_CREDS_DIR=
# PostgreSQL log_connections (who connected, from where, as which role). false only skips turning it on.
# LOG_CONNECTIONS=true
# Exporter / Portainer release pins. Set the matching SHA256 whenever you change a version (downloads are verified).
# POSTGRES_EXPORTER_VERSION=0.20.1
# POSTGRES_EXPORTER_SHA256=89d4f7e7920cad48fdc3133f789556ef5253c330a9f5fdace3bdb6344c0a8b5a
# KAFKA_EXPORTER_VERSION=1.11.0
# KAFKA_EXPORTER_SHA256=6a14dd10709d627d7be29a4b98fae8bb888761c7da54410e72bef8cdaf906e86
# PORTAINER_SHA256=
# Automation: ASSUME_YES=1 answers the two confirmations (same as --yes); SKIP_PREREQS=1 skips phase 1.
# ASSUME_YES=
# SKIP_PREREQS=

# ── Beckn add-on (optional — one-click-installer/install-beckn.sh, docs/beckn.md) ──────────────────────────────────
# Run AFTER install.sh, with this same file. It adds network participants to the machine. Two protocols:
#   CCE flows       Sygnal (CCE profile): sygnal/event/report OpenMRS -> HIE -> CCE, sygnal/signal/emit (care alerts)
#                   CCE -> OpenMRS. Each participant has one Sygnal adapter (onix-sygnal, one identity).
#   Spice referrals standard Beckn, the messages UNCHANGED: select / init / confirm / status / update between Spice and
#                   OpenMRS, through OpenMRS's Beckn adapter pair (onix-bap / onix-bpp) and its BAP and BPP records.
#                   The pair is on onix 1.9.4 (before: 1.6.1), so Spice's referral adapter must be on 1.9.4 too
#                   (docs/beckn.md, "Change 2026-11-23: the referral adapters on onix 1.9.4").
# Each participant has its own public host, which needs a DNS name pointing here and INGRESS_HOST + ACME_EMAIL above (the
# addresses are HTTPS). Leave BECKN_COMPONENTS empty to skip the add-on.
#   cce      cce-beckn-service + CCE's adapter, in the cce-<ENVCODE> namespace:  HMIS events in, care alerts out
#   openhim  OpenHIM (the HIE) + the Beckn build of openhim-cce-emitter-adaptor + its adapter, in its own namespace
#   openmrs  OpenMRS O3 + openmrs-cce-emitter-adaptor and -receiver-adaptor (Beckn builds) + its adapter, in its own namespace
# A participant that runs on ANOTHER machine is left out of BECKN_COMPONENTS, but its id and address below are still
# needed: each participant's settings name its neighbours.
# BECKN_COMPONENTS=cce openhim openmrs

# The DeDi registry every adapter looks senders up in (default below). The adapters (onix 1.9.4) search every registry:
# BECKN_REGISTRY_NAME, which OpenMRS's referral pair needed on onix 1.6.1, is no longer read.
# BECKN_REGISTRY_URL=https://fabric.nfh.global/registry/dedi
# The Sygnal network of the CCE flows: <namespace>/<registry> of its membership registry, as shown in each subscriber
# record's network_memberships. Every service sends it as context.networkId of a Sygnal message — the registry refuses a
# sender that is not a member — and every Sygnal adapter accepts only subscribers that are members of it. Every id that
# sends or receives Sygnal (CCE, the HIE, OpenMRS, Spice) must be a member. Default: the CCE demo network.
# BECKN_SYGNAL_NETWORK_ID=sygnal.nextsteps.mdtlabs.org/sygnal_demo_network_registry
# Only to accept subscribers of MORE networks: comma-separated list for the Sygnal adapters (default: BECKN_SYGNAL_NETWORK_ID).
# BECKN_SYGNAL_ALLOWED_NETWORK_IDS=
# The network of the Spice <-> OpenMRS referrals (standard Beckn, unchanged): context.networkId of the referral messages,
# and OpenMRS's onix-bap / onix-bpp accept only its members (BECKN_ALLOWED_NETWORK_IDS: a list, default BECKN_NETWORK_ID).
# Empty = no networkId and no membership check.
# BECKN_NETWORK_ID=beckn.example.org/example_network_registry
# BECKN_ALLOWED_NETWORK_IDS=

# Per participant (CCE / OPENHIM / OPENMRS): the public host, and the subscriber id + registry key (record) id of its ONE
# Sygnal identity. Its Sygnal address is https://<host>/sygnal/receiver — the context.receiverUri its peers send to (set
# BECKN_<P>_URI only for a participant hosted elsewhere without a host here). Delivery never uses the URL in the registry
# record; changing it to /sygnal/receiver is optional, and only for ids used by Sygnal alone (CCE, the HIE).
# Unset, BECKN_<P>_ID / BECKN_<P>_KEY_ID are taken from the record each participant used before (an older config keeps
# working): CCE its BPP (BECKN_CCE_BPP_ID / _BPP_KEY_ID), the HIE and OpenMRS their BAP (BECKN_<P>_BAP_ID / _BAP_KEY_ID).
# BECKN_CCE_HOST=cce.example.org
# BECKN_CCE_ID=bpp.cce.example.org
# BECKN_CCE_KEY_ID=
# BECKN_OPENHIM_HOST=hie.example.org
# BECKN_OPENHIM_ID=bap.hie.example.org
# BECKN_OPENHIM_KEY_ID=
# BECKN_OPENMRS_HOST=openmrs.example.org
# BECKN_OPENMRS_ID=bap.openmrs.example.org
# BECKN_OPENMRS_KEY_ID=
# OpenMRS's Beckn referral pair (required with openmrs): its BAP and BPP records, registered at https://<host>/bap/receiver
# and https://<host>/bpp/receiver (set BECKN_OPENMRS_BAP_URI / _BPP_URI if a record says otherwise). The BAP record is
# normally also OpenMRS's Sygnal identity (above): leave its URL as it is (the referrals use it).
# BECKN_OPENMRS_BAP_ID=bap.openmrs.example.org
# BECKN_OPENMRS_BAP_KEY_ID=
# BECKN_OPENMRS_BPP_ID=bpp.openmrs.example.org
# BECKN_OPENMRS_BPP_KEY_ID=

# The adapters' PUBLIC keys, as registered. One pair for every participant on this machine (below), or per participant
# (BECKN_<P>_SIGNING_PUBLIC_KEY / BECKN_<P>_ENCR_PUBLIC_KEY); an older config's per-role key of the record above
# (BECKN_CCE_BPP_…, BECKN_OPENHIM_BAP_…, BECKN_OPENMRS_BAP_…) wins over both.
# The PRIVATE keys are secrets: never here. Put them, with the same names ending _PRIVATE_KEY, in BECKN_SEED_ENV_FILE.
# BECKN_SIGNING_PUBLIC_KEY=
# BECKN_ENCR_PUBLIC_KEY=
# KEY=value file OUTSIDE the repo, read into Infisical /beckn on each run: the private keys (required once), and any value
# you want instead of a generated one — a referral contract id agreed with Spice, the OpenMRS login the adaptors use
# (OPENMRS_ADMIN_USER / OPENMRS_ADMIN_PASSWORD).
# Everything else in /beckn is generated. docs/beckn.md lists every key.
# BECKN_SEED_ENV_FILE=

# The schemas the adapters check messages against, all from cce-beckn-service's schema/ folder:
#   - the CCE profile of Sygnal (sygnal-profile/v3.0/cce-sygnal-apis.yaml): the Sygnal adapters' only spec, and all they
#     need. It is CCE's copy of the Sygnal schema with sygnal:CoordinationEvent and sygnal:Signal opened and extended:
#     sygnal/event/report carries one sygnal:CoordinationEvent with the fields of a clinical event on it (patientId,
#     fhirVersion, resource, ...), sygnal/signal/emit a sygnal:Signal with the fields of a care alert on it. No bag, no
#     cce: type and no "@context" in these messages, so a Sygnal adapter holds no payload schemas.
#   - CceClinicalEvent v1.0 and CceCareAlert v1.0: for OpenMRS's Beckn referral pair only (BECKN_REFERRAL_SCHEMAS).
# A folder on this machine that holds them (a copy of that schema/), or empty to fetch them from BECKN_SCHEMA_REPO at
# BECKN_SCHEMA_REF (a ref that has sygnal-profile/v3.0; the install stops when it is missing). BECKN_SYGNAL_PROFILE names
# another profile file.
# Until cce-beckn-service pull request #7 (its branch cce-payload-types) is merged into demo, demo has only profile
# v1.0: set BECKN_SCHEMA_REF=cce-payload-types, or BECKN_SCHEMA_DIR to the schema/ folder of a checkout of that branch.
# BECKN_REFERRAL_SCHEMAS names, explicitly, the version folders OpenMRS's Beckn referral pair (onix-bap / onix-bpp)
# holds, unchanged: the referral legs carry the CceClinicalEvent v1.0 box (the Health* pack is added from this
# repository). An adapter finds a schema by its type name, so it holds one version of a type.
# BECKN_SCHEMA_BASE_URL is the start of the @context address of CCE's schemas, a setting of the three services: it must
# be the same for all participants of the network (it need not be downloadable). The Sygnal messages carry no @context.
# BECKN_SCHEMA_DIR=
# BECKN_SYGNAL_PROFILE=
# BECKN_SCHEMA_REPO=https://github.com/openphc/cce-beckn-service.git
# BECKN_SCHEMA_REF=demo
# BECKN_REFERRAL_SCHEMAS="CceClinicalEvent/v1.0 CceCareAlert/v1.0"
# BECKN_SCHEMA_BASE_URL=https://raw.githubusercontent.com/openphc/cce-beckn-service/main/schema

# Images. cce-beckn-service: CI of its demo branch pushes v<N> and latest. The three adaptors: CI of their demo-beckn
# branches pushes demo-beckn-v<N> and demo-beckn-latest (the default). A value is a tag or a sha256: digest. They must
# be Sygnal builds (sygnal/event/report, sygnal/signal/emit) for the CCE profile v3.0.
# IMAGE_CCE_BECKN_SERVICE=latest
# IMAGE_OPENHIM_BECKN_EMITTER_ADAPTOR=demo-beckn-latest
# IMAGE_OPENMRS_CCE_EMITTER_ADAPTOR=demo-beckn-latest
# IMAGE_OPENMRS_CCE_RECEIVER_ADAPTOR=demo-beckn-latest
# IfNotPresent (default): use an image imported into k3s by hand and never pull — needed while the cce-beckn-service
# package cannot be pulled without a login. Always: pull on every start, like the other services.
# BECKN_CCE_IMAGE_PULL_POLICY=IfNotPresent

# Spice — an external HMIS, in two roles:
#   Sygnal (CCE flows): once BECKN_SPICE_ID is set (default: BECKN_SPICE_BAP_ID), the HIE accepts Spice's events (Spice
#     sends sygnal/event/report to the HIE's address) and CCE sends Spice its care alerts (sygnal/signal/emit to
#     BECKN_SPICE_URI, Spice's https://<host>/sygnal/receiver; no alerts without it).
#   Beckn referrals with OpenMRS (the messages and these keys are unchanged; Spice's referral adapter must be on onix
#     1.9.4, as OpenMRS's is): BECKN_SPICE_BAP_* / _BPP_* / _FACILITY_CODES. Until the BAP id is known the
#     OpenMRS receiver starts with placeholder ids. BECKN_REFERRALS_ENABLED=true turns on the two referral legs of the
#     OpenMRS emitter (it then needs every key below, and the "referrals out" ids from Spice in Infisical).
# BECKN_SPICE_ID=
# BECKN_SPICE_URI=
# BECKN_SPICE_BAP_ID=
# BECKN_SPICE_BAP_URI=
# BECKN_SPICE_BPP_ID=
# BECKN_SPICE_BPP_URI=
# BECKN_SPICE_FACILITY_CODES=
# BECKN_REFERRALS_ENABLED=false

# Namespaces of the two non-CCE participants, the node folder that holds OpenMRS's frontend site files, the adapters' log
# level (debug prints message bodies: patient data), and the HIE adaptor's facility filter (empty = every facility).
# BECKN_OPENHIM_NAMESPACE=openhim
# BECKN_OPENMRS_NAMESPACE=openmrs
# BECKN_OPENMRS_HOST_DIR=/opt/openmrs
# BECKN_ONIX_LOG_LEVEL=info
# BECKN_OPENHIM_FACILITY_FILTER_IDS=

# The HIE adaptor's clinical-data redaction. false (default) forwards full payloads, so CCE receives patient data: the
# protocol triggers read free text that redaction removes (the RMNCH referral steps read ServiceRequest.patientInstruction
# / orderDetail and the Encounter source-referral-order extension). true removes clinical content before an event goes
# to CCE — only where no trigger needs it.
# BECKN_OPENHIM_REDACTION_ENABLED=false

# Health referrals from Spice: the OpenMRS identifier type for each patient health id system, SYSTEM=type pairs separated
# by ";". The default stores Spice's national id (system NID) as national-id, the id the OpenMRS emitter sends to CCE.
# BECKN_HEALTH_ID_TYPES=NID=national-id
