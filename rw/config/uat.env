# ════════════════════════════════════════════════════════════════════════════════════════════════════
#  RW one-click install — RW UAT on 102.215.10.21 (dedicated machine), CCE services built from the RW-MOH GitLab
#
#      sudo bash rw/one-click-install.sh --config rw/config/uat.env [--yes]
#
#  NO SECRETS here. The GitLab token is read from GIT_TOKEN_FILE (or the GIT_TOKEN environment variable); passwords live in
#  Infisical (generated, or supplied once via SEED_ENV_FILE, which sits outside the repo). Any key can be overridden from the
#  environment. Platform keys are the same as one-click-installer/config/example.env, which documents each one.
# ════════════════════════════════════════════════════════════════════════════════════════════════════

# ── Environment identity ───────────────────────────────────────────────────────────────────────────
ENVCODE=uat
# k8s/overlays/uat already exists (the shared-host UAT on 102.215.10.20), so this env gets its own overlay directory.
OVERLAY_NAME=rw-uat
OVERLAY_TEMPLATE=prod

# ── Public access ──────────────────────────────────────────────────────────────────────────────────
# The UAT domain, as on 102.215.10.20 (values from its Infisical). It also sets the token issuer the gateway checks
# (https://<INGRESS_HOST>/auth/realms/cce), so OpenHIM's calls authenticate on .21 exactly as on .20.
# Until DNS points cceuat.moh.gov.rw at .21: the ingress answers only to that host name (test with
# curl -H 'Host: cceuat.moh.gov.rw' http://102.215.10.21/...), and Let's Encrypt issues the certificate after the cutover.
INGRESS_HOST=cceuat.moh.gov.rw
ACME_EMAIL=info@moh.gov.rw

# ── Hosting / network security (same as PROD: on-prem, UFW default-deny, only 22/80/443 public) ─────
IS_CLOUD_DEPLOYMENT=false
SSH_ALLOWED_CIDR=
UFW_EXTRA_ALLOW=

# ── Secrets store: a local Infisical on this machine — installed NATIVELY (one-click-installer/lib/infisical-native.sh: infisical-core, Redis,
#    a database in the native PostgreSQL; 127.0.0.1:8080 only). INFISICAL_CORE_VERSION pins the package. ─────────────────
USE_LOCAL_INFISICAL=true
INFISICAL_CORE_VERSION=0.162.24-1
INFISICAL_DOMAIN=http://localhost:8080
# KEY=value file kept OUTSIDE the repo (chmod 600). REQUIRED in it, or intelligence-service will not start:
#   CCE_INTELLIGENCE_SMTP_HOST / _USERNAME / _PASSWORD, CCE_INTELLIGENCE_ALERT_EMAIL_TIER1..3, CCE_INTELLIGENCE_ALERT_NAME_TIER1..3
# Optional: OPENHIM_* settings, FACILITY_FILTER_IDS, passwords you want instead of generated ones — e.g. GRAFANA_ADMIN_PASSWORD,
# KEYCLOAK_ADMIN_PASSWORD, PORTAINER_ADMIN_PASSWORD (min 12 chars; applied on first install — later: one-click-installer/lib/set-admin-passwords.sh).
SEED_ENV_FILE=/root/cce-uat-seed.env

# ── Keycloak login theme: RW-branded, as on PROD ───────────────────────────────────────────────────
KEYCLOAK_THEME_DIR=keycloak-themes/insights-ui-theme

# ── Sizing deviations from PROD (rw/lib/overlay-tweaks.sh) ───────────────────────────────────────
# One replica of every CCE service on this machine: every HPA gets minReplicas = maxReplicas = HPA_REPLICAS (empty = PROD's).
HPA_REPLICAS=1
# Per-deployment CPU limit, comma-separated <deployment>=<cpu>. Protocol's base 500m made its ~2-minute startup outlast the
# liveness probe (exit 137).
# step-sla 800m (2026-11-06): release-2.0.0 346cf19 needs ~100 s to start at 500m, right at the liveness limit (60 s + 3×15 s).
CPU_LIMIT_OVERRIDES=cce-protocol-service=800m,cce-step-sla-service=800m

# ── Platform versions (what RW PROD runs) ──────────────────────────────────────────────────────────
K3S_VERSION=v1.35.4+k3s1
INFISICAL_CLI_VERSION=0.43.93
CLICKHOUSE_VERSION=26.5
POSTGRES_VERSION=16
# Kafka + Kafka Connect. 3.9.2 (not 3.7.0, the reference PROD): fixes CVE-2025-27817/-27818 in Connect. Raising it on an existing
# machine upgrades Kafka in place on the next run (k8s/infrastructure/setup-prod-infra.sh; data kept, old install kept as rollback).
KAFKA_VERSION=3.9.2
DEBEZIUM_VERSION=3.0.0.Final
ENABLE_PG_STAT_STATEMENTS=true
# Postgres/Kafka exporters as systemd services (release binaries), not containers — this machine runs no docker containers.
EXPORTER_RUNTIME=systemd

# ── Source code: RW-MOH GitLab ─────────────────────────────────────────────────────────────────────
# File holding a GitLab access token with read_repository (chmod 600, outside the repo). Not needed for public repos.
GIT_TOKEN_FILE=/root/.cce-gitlab.token
# Where the repos are cloned. One directory per repo, side by side: the 2.0 services build against ../cce-common-util.
SOURCE_DIR=/opt/cce-src
# Name the locally built images get (imported straight into k3s — no registry involved).
LOCAL_IMAGE_REGISTRY=cce.local/rw

# One REPO + BRANCH per repository. BRANCH can also be a tag or a full 40-character commit SHA (an exact pin). A repo whose branch is missing stops the install before anything
# is built, with the full list of what is missing.
SRC_CCE_COMMON_UTIL_REPO=https://repository.moh.gov.rw/cce/cce-common-util.git
# Unpinned 2026-11-06: openphc/cce-matcher-service#24 (CCE-135 step groups, matcher V8) merged and mirrored (matcher release-2.0.0 = 8bcdc83).
# Was pinned to 528bf35 because matcher could not compile against the CCE-135 common-util.
SRC_CCE_COMMON_UTIL_BRANCH=release-2.0.0
SRC_CCE_COLLECTOR_SERVICE_REPO=https://repository.moh.gov.rw/cce/cce-collector-service.git
SRC_CCE_COLLECTOR_SERVICE_BRANCH=release-2.0.0
SRC_CCE_PROTOCOL_SERVICE_REPO=https://repository.moh.gov.rw/cce/cce-protocol-service.git
# Unpinned 2026-11-06: openphc/cce-matcher-service#24 (CCE-135 step groups, matcher V8) merged and mirrored (was pinned to ee20158 together with common-util).
SRC_CCE_PROTOCOL_SERVICE_BRANCH=release-2.0.0
SRC_CCE_MATCHER_SERVICE_REPO=https://repository.moh.gov.rw/cce/cce-matcher-service.git
SRC_CCE_MATCHER_SERVICE_BRANCH=release-2.0.0
SRC_CCE_STEP_SLA_SERVICE_REPO=https://repository.moh.gov.rw/cce/cce-step-sla-service.git
SRC_CCE_STEP_SLA_SERVICE_BRANCH=release-2.0.0
SRC_CCE_INTELLIGENCE_SERVICE_REPO=https://repository.moh.gov.rw/cce/cce-intelligence-service.git
# demo = the 2.0 intelligence (receiver_adaptor / destination_adaptor_mapping / intelligence_delivery), which the 2.0 data pipeline's
# CDC replicates. demo-rw is the 1.x RW line (ops-alert e-mails, notification_tracker only) — CDC can never complete with it.
# Chosen 2026-11-04; ops-alert e-mails stay inactive until a branch carries both.
SRC_CCE_INTELLIGENCE_SERVICE_BRANCH=demo
SRC_CCE_INSIGHTS_SERVICE_REPO=https://repository.moh.gov.rw/cce/cce-insights-service.git
# Unpinned 2026-11-06: openphc/cce-matcher-service#24 (CCE-135 step groups, matcher V8) merged and mirrored (was pinned to 664b411, the last pre-step-groups commit).
SRC_CCE_INSIGHTS_SERVICE_BRANCH=demo-rw-v2
SRC_CCE_INSIGHTS_UI_REPO=https://repository.moh.gov.rw/cce/cce-insights-ui.git
# Unpinned 2026-11-06: openphc/cce-matcher-service#24 (CCE-135 step groups, matcher V8) merged and mirrored (was pinned to 10d19ab, the last pre-step-groups commit).
SRC_CCE_INSIGHTS_UI_BRANCH=demo-rw-v2
SRC_CCE_DATA_PIPELINE_REPO=https://repository.moh.gov.rw/cce/cce-data-pipeline.git
# Unpinned 2026-11-06: openphc/cce-matcher-service#24 (CCE-135 step groups, matcher V8) merged and mirrored (was pinned to 930b4d7).
# An EXISTING ClickHouse moving to the step-group schema needs schema/10-step-groups-upgrade.sql once (a fresh install does not).
SRC_CCE_DATA_PIPELINE_BRANCH=demo-v2
SRC_GATEWAY_SERVICE_REPO=https://repository.moh.gov.rw/cce/gateway-service.git
SRC_GATEWAY_SERVICE_BRANCH=main
SRC_OPENHIM_CCE_EMITTER_ADAPTOR_REPO=https://repository.moh.gov.rw/cce/openhim-cce-emitter-adaptor.git
SRC_OPENHIM_CCE_EMITTER_ADAPTOR_BRANCH=release-1.0.0

# insights-ui build-time settings (Vite inlines them into the bundle). Defaults = the CI build PROD runs; an empty
# KEYCLOAK_URL means "<page origin>/auth", which is right behind this deployment's ingress.
INSIGHTS_UI_VITE_AUTH_ENABLED=true
INSIGHTS_UI_VITE_KEYCLOAK_URL=
INSIGHTS_UI_VITE_KEYCLOAK_REALM=cce
INSIGHTS_UI_VITE_KEYCLOAK_CLIENT_ID=cce-insights-ui
INSIGHTS_UI_VITE_ROUTER_BASE=/insights
INSIGHTS_UI_VITE_TIMEZONE=UTC
