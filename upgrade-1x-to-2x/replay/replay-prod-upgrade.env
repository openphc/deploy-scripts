# Settings: Rwanda prod, upgrade CCE 1.x -> 2.0 by replay (REPLAY-RUNBOOK.md part U).
# Prod runs on Kubernetes (namespace cce-prod) with Postgres, Kafka, Kafka Connect and ClickHouse
# installed on the server, which it shares with UAT: only this file decides that a command changes prod.
# Secrets (ClickHouse user and password) come from Infisical, so run every step through
# rw/lib/infisical-run.sh, from the folder that holds rw/, data-pipeline/ and upgrade-1x-to-2x/:
#   R="sudo -A bash rw/lib/infisical-run.sh prod bash upgrade-1x-to-2x/replay/replay-inbound-events.sh --config upgrade-1x-to-2x/replay/replay-prod-upgrade.env"
#   $R check
# Every setting is explained in replay.env.

DEPLOYMENT_NAME=rw-prod

PLATFORM=kubernetes
KUBECTL="k3s kubectl"
K8S_NAMESPACE=cce-prod

PG_EXEC="sudo -u postgres"
PG_PORT=5432
KAFKA_EXEC=""
KAFKA_TOOLS_DIR=/opt/kafka/bin
KAFKA_TOOL_SUFFIX=.sh
KAFKA_BOOTSTRAP=localhost:9092
CONNECT_EXEC=""
CONNECT_URL=http://localhost:8086
CH_HTTP=http://localhost:8124

# With sudo, keep backups and progress in one place whichever way a step is run.
STATE_DIR=/root/cce-replay/rw-prod
# DATA_PIPELINE_DIR defaults to the 2.0 data-pipeline/ next to upgrade-1x-to-2x/.

INSIGHTS_SERVICES="cce-insights-service cce-insights-ui"

# ---- The upgrade block (1.x -> 2.0). After the upgrade, switch to the 2.0 values in replay.env. ----
SERVICES="cce-matcher-service cce-protocol-service cce-step-sla-service cce-intelligence-service"
SCHEMA_ORDER="cce-protocol-service cce-matcher-service cce-intelligence-service"
CONSUMER_GROUP=cce-matcher-service
DROP_TABLES="protocol_definition action_definition trigger_index
  matcher_event_log protocol_instance protocol_instance_history step_instance step_instance_history
  step_sla_state_transition deviation intelligence_event_log facility receiver_adaptor
  destination_adaptor_mapping intelligence_delivery intelligence_delivery_audit_log notification_tracker
  compliance_event_log audit_log scheduler_lease scheduler_scan_cursor"
# Put back, in this order: configuration, then the history of the alerts already sent.
RESTORE_TABLES="protocol_definition action_definition trigger_index facility receiver_adaptor
  destination_adaptor_mapping intelligence_delivery intelligence_delivery_audit_log notification_tracker"
