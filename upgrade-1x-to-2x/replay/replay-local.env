# Example settings: a replay on a laptop running CCE 2.0 in Docker (a full rebuild or a fill-gaps).
# Copy it, adjust the container names and ports to your setup, then run:
#   R="bash upgrade-1x-to-2x/replay/replay-inbound-events.sh --config <your copy>"
#   $R check
# Every setting is explained in replay.env; the runbook is REPLAY-RUNBOOK.md.

DEPLOYMENT_NAME=local                  # backups and progress go to ~/cce-replay/local/

# How the services run: containers by name (docker run) ...
PLATFORM=docker
# ... or Docker Compose: the folder with your docker-compose.yml (and -f/-p options if it needs them)
# PLATFORM=compose
# COMPOSE_DIR=$HOME/<your-cce-compose-folder>
# COMPOSE_OPTS="-f docker-compose.yml"

# Postgres, Kafka and Kafka Connect: the containers their tools run in
PG_EXEC="docker exec -i cce-collector-postgres"
KAFKA_EXEC="docker exec -i cce-collector-kafka"
KAFKA_TOOLS_DIR=/opt/kafka/bin         # Apache Kafka image; remove both lines for a Confluent image
KAFKA_TOOL_SUFFIX=.sh
KAFKA_BOOTSTRAP=localhost:9092         # the broker, as seen from inside the Kafka container
CONNECT_EXEC="docker exec -i cce-kafka-connect"
CONNECT_URL=http://localhost:8083      # Kafka Connect, as seen from inside its container
CONNECT_HOST_URL=http://localhost:8084 # Kafka Connect, as seen from this laptop (its published port)
CH_HTTP=http://localhost:8123          # ClickHouse over HTTP, from this laptop

# ClickHouse user and password: a file (mode 600) with two lines, CH_USER=... and CH_PASSWORD=...
SECRETS_FILE=$HOME/.cce-replay-secrets.env

# Services that read ClickHouse, stopped while it is rebuilt (A8) and started again afterwards
INSIGHTS_SERVICES="cce-insights-service cce-insights-ui"

# What is replayed (CCE 2.0). The first service in SERVICES consumes the inbound topic.
SERVICES="cce-matcher-service cce-step-sla-service cce-intelligence-service"
DROP_TABLES="matcher_event_log protocol_instance protocol_instance_history step_instance
  step_instance_history step_sla_state_transition deviation intelligence_event_log facility
  receiver_adaptor destination_adaptor_mapping intelligence_delivery intelligence_delivery_audit_log
  notification_tracker"
RESTORE_TABLES="facility receiver_adaptor destination_adaptor_mapping intelligence_delivery
  intelligence_delivery_audit_log notification_tracker"

# The data-pipeline ClickHouse is rebuilt with. Default: data-pipeline/ at the deploy-scripts root.
# DATA_PIPELINE_DIR=$HOME/<path>/data-pipeline
