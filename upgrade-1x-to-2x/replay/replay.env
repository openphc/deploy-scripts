# replay.env — settings for replay-inbound-events.sh on THIS server (bash syntax: quote values with
# spaces). Run `replay-inbound-events.sh check`, then `plan`, after changing anything.
# Examples for every kind of setup: REPLAY-RUNBOOK.md, "Fill in upgrade-1x-to-2x/replay/replay.env";
# what each setting does and when the optional ones are needed (EXEC="", PG_USER/HOST/PORT,
# KAFKA_TOOL_SUFFIX, CONNECT_HOST_URL, COMPOSE_OPTS, ...): its "How each connection setting is used".
# ready-made laptop examples: replay-local.env and replay-local-upgrade.env next to this file.

# ---- Which deployment ---------------------------------------------------------------------------
DEPLOYMENT_NAME=cce                 # printed by every step; backups go to STATE_DIR (below)

# ---- How the services run -----------------------------------------------------------------------
# compose (+ COMPOSE_DIR) | docker (containers by name) | kubernetes (+ KUBECTL, K8S_NAMESPACE).
# Each name in SERVICES is a Compose service, a container or a Deployment of that name.
PLATFORM=compose
COMPOSE_DIR=/opt/deployment
# COMPOSE_OPTS="-p <project> -f <file>"    # only if 'docker compose' in COMPOSE_DIR needs them
# KUBECTL="k3s kubectl"
# K8S_NAMESPACE=cce-prod

# ---- How Postgres, Kafka and Kafka Connect are reached ------------------------------------------
# Each through a command prefix that runs a program where its tools are, passing stdin through:
#   a container          "docker exec -i <container>"
#   a pod                "kubectl -n <namespace> exec -i <pod, e.g. statefulset/postgres> --"
#   installed here       "sudo -u postgres" (Postgres), or empty ("") to run the tools directly
# (The older PG_ACCESS / KAFKA_ACCESS / CONNECT_ACCESS settings still work.)

# Postgres: psql, pg_dump and pg_restore run through PG_EXEC. They connect as PG_USER if set, else as
# the database image's POSTGRES_USER, else as the OS user; PG_HOST / PG_PORT only when not the default.
PG_EXEC="docker exec -i cce-postgres"
# PG_DB=ccedb
# PG_USER=
# PG_HOST=
# PG_PORT=

# Kafka: the kafka-* tools run through KAFKA_EXEC. Apache Kafka tools end in .sh and live in
# /opt/kafka/bin (KAFKA_TOOL_SUFFIX=.sh, KAFKA_TOOLS_DIR=/opt/kafka/bin); Confluent images have them
# on the PATH without suffix. KAFKA_BOOTSTRAP is the broker as seen from where the tools run.
# KAFKA_CLIENT_CONFIG: a client properties file (SASL/TLS), where the tools run, if the broker needs one.
KAFKA_EXEC="docker exec -i kafka"
KAFKA_BOOTSTRAP=kafka:9092
# KAFKA_TOOLS_DIR=/opt/kafka/bin
# KAFKA_TOOL_SUFFIX=.sh
# KAFKA_CLIENT_CONFIG=/etc/kafka/client.properties

# Kafka Connect: curl runs through CONNECT_EXEC against CONNECT_URL (as seen from there).
CONNECT_EXEC="docker exec -i cce-kafka-connect"
CONNECT_URL=http://localhost:8083
# CONNECT_HOST_URL=http://localhost:8083   # Connect as seen from THIS host (only if no connector exists to copy)

# ClickHouse: over HTTP, from this host (a port-forward if it runs in a cluster).
CH_HTTP=http://localhost:8123
# DATA_PIPELINE_DIR=/opt/deployment/data-pipeline   # the DEPLOYED release's data-pipeline (default: data-pipeline/ at the deploy-scripts root)

# ClickHouse password: a file with CH_USER/CH_PASSWORD (or CLICKHOUSE_*) — dev, below — or Infisical.
# On UAT/prod don't set either: run the script under rw/lib/infisical-run.sh <uat|prod>, like every
# other rw script, and the CLICKHOUSE_* secrets are already in the environment (REPLAY-RUNBOOK.md,
# "Fill in upgrade-1x-to-2x/replay/replay.env"). INFISICAL_CREDENTIALS (a k8s/.infisical.<env> file) is only for a
# server without rw/lib/infisical-run.sh.
SECRETS_FILE=/opt/deployment/data-pipeline/.env
# INFISICAL_CREDENTIALS="$SCRIPT_DIR/../../k8s/.infisical.prod"

# Backups and replay progress. Every step must use the same folder: set this when steps may be run
# both with and without sudo (each would otherwise use its own home folder).
# STATE_DIR=/var/lib/cce-replay/cce

# ---- What the replay does -----------------------------------------------------------------------
# Services stopped before the replay and started again after, in this order. The FIRST one reads
# cce.events.inbound (it starts as soon as the events are sent; the others once it has caught up).
SERVICES="cce-matcher-service cce-step-sla-service cce-intelligence-service"

# Tables those services create: dropped by a rebuild, and created again by the services' own
# migrations when they start. Every table in the database not listed here is left as it is
# (inbound_event_log is never touched).
DROP_TABLES="matcher_event_log protocol_instance protocol_instance_history step_instance
  step_instance_history step_sla_state_transition deviation intelligence_event_log facility
  receiver_adaptor destination_adaptor_mapping intelligence_delivery intelligence_delivery_audit_log
  notification_tracker"

# Of those, the tables whose data is put back from before the rebuild, in this order (a table after
# the ones it points at): configuration, and the history of the alerts already sent
# (intelligence_delivery and its audit log, kept with their ids; nothing is sent again, the
# intelligence service only sends on a new trigger). intelligence_event_log is not put back: it
# points at enrolments and steps, which the rebuild creates again with new ids.
RESTORE_TABLES="facility receiver_adaptor destination_adaptor_mapping intelligence_delivery
  intelligence_delivery_audit_log notification_tracker"

# The order the services are started in to create their tables (default: SERVICES). Only needed when
# a service's migrations need another's tables — see the upgrade block below.
# SCHEMA_ORDER="..."

# The Kafka consumer group whose lag 'wait' follows. Leave unset: it is found automatically (the group
# reading cce.events.inbound, normally named after the first service, e.g. cce-matcher-service). Set it
# only when the group reading the topic today is not the one that will — see the upgrade block below.
# CONSUMER_GROUP=cce-matcher-service

# Services that read ClickHouse: 'rebuild-clickhouse' stops the running ones while it rebuilds, and
# starts them again once the copy has settled (waiting up to CH_SETTLE_MINUTES). Empty: none.
# INSIGHTS_SERVICES="cce-insights-service cce-insights-ui"
# CH_SETTLE_MINUTES=30

# How long a service may take to start, and to exit once stopped (seconds).
# SERVICE_START_TIMEOUT=300
# SERVICE_STOP_TIMEOUT=300

# Only CCE's own Kafka topics and consumer groups are ever emptied / reset (other applications may
# share the broker). Defaults shown.
# TOPIC_PATTERN='^cce\.'
# GROUP_PATTERN='^cce-'

# ---- Upgrading CCE 1.x -> 2.0 by replay (instead of the database migration) ----------------------
# REPLAY-RUNBOOK.md part U: remove compliance and scheduler, deploy the 2.0 services WITHOUT starting
# them (Flyway on, baseline 0, baseline-on-migrate true), then use this block. The 1.x protocol tables
# are rebuilt by Protocol's own migrations and their rows put back, so Protocol is in SERVICES and
# builds FIRST (Matcher's tables point at protocol_definition). The 1.x-only tables at the end are not
# recreated by any 2.0 service: they come back empty (compliance_event_log stays in replay_old instead
# when 1.x step_instance has a foreign key to it).
# Going back to 1.x: 'revert --yes --no-start', never a plain 'revert' (it would start 2.0 on 1.x).
# After the upgrade, switch this file back to the 2.0 values above.
# SERVICES="cce-matcher-service cce-protocol-service cce-step-sla-service cce-intelligence-service"
# SCHEMA_ORDER="cce-protocol-service cce-matcher-service cce-intelligence-service"
# CONSUMER_GROUP=cce-matcher-service     # the 1.x group cce-compliance-service still reads the topic
# DROP_TABLES="protocol_definition action_definition trigger_index
#   matcher_event_log protocol_instance protocol_instance_history step_instance step_instance_history
#   step_sla_state_transition deviation intelligence_event_log facility receiver_adaptor
#   destination_adaptor_mapping intelligence_delivery intelligence_delivery_audit_log notification_tracker
#   compliance_event_log audit_log scheduler_lease scheduler_scan_cursor"
# RESTORE_TABLES="protocol_definition action_definition trigger_index facility receiver_adaptor
#   destination_adaptor_mapping intelligence_delivery intelligence_delivery_audit_log notification_tracker"

# ---- CCE 1.x instead ----------------------------------------------------------------------------
# SERVICES="cce-compliance-service cce-scheduler-service"
# DROP_TABLES="compliance_event_log protocol_definition action_definition trigger_index protocol_instance
#   protocol_instance_history step_instance step_instance_history deviation intelligence_event_log
#   facility audit_log scheduler_lease scheduler_scan_cursor"
# RESTORE_TABLES="protocol_definition action_definition trigger_index facility audit_log"
