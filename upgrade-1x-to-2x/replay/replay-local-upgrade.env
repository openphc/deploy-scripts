# Example settings: the 1.x -> 2.0 upgrade by replay (REPLAY-RUNBOOK.md, part U) on a laptop running
# CCE 1.x in Docker, e.g. on a restored copy of a 1.x database. Copy it, adjust the container names
# and ports to your setup, then run:
#   R="bash upgrade-1x-to-2x/replay/replay-inbound-events.sh --config <your copy>"
#   $R check
# Every setting is explained in replay.env.

DEPLOYMENT_NAME=local-upgrade          # backups and progress go to ~/cce-replay/local-upgrade/

# How the services run: containers by name (docker run) ...
PLATFORM=docker
# ... or Docker Compose: the folder with your docker-compose.yml. The 2.0 services must be defined in it
# (or in an extra file given with -f) so that U3 can create them.
# PLATFORM=compose
# COMPOSE_DIR=$HOME/<your-cce-compose-folder>
# COMPOSE_OPTS="-f docker-compose.yml -f docker-compose.2x.yml"

# Postgres, Kafka and Kafka Connect: the containers their tools run in
PG_EXEC="docker exec -i cce-collector-postgres"
KAFKA_EXEC="docker exec -i cce-collector-kafka"
KAFKA_TOOLS_DIR=/opt/kafka/bin         # Apache Kafka image; remove both lines for a Confluent image
KAFKA_TOOL_SUFFIX=.sh
KAFKA_BOOTSTRAP=localhost:9092         # the broker, as seen from inside the Kafka container
CONNECT_EXEC="docker exec -i cce-kafka-connect"
CONNECT_URL=http://localhost:8083      # Kafka Connect, as seen from inside its container
CONNECT_HOST_URL=http://localhost:8084 # Kafka Connect, as seen from this laptop (its published port)
CH_HTTP=http://localhost:8123          # ClickHouse over HTTP, from this laptop

# ClickHouse user and password: a file (mode 600) with two lines, CH_USER=... and CH_PASSWORD=...
SECRETS_FILE=$HOME/.cce-replay-secrets.env

# Services that read ClickHouse, stopped while it is rebuilt (A8); in part U they stay stopped until U6
INSIGHTS_SERVICES="cce-insights-service cce-insights-ui"

# The upgrade block: the 2.0 services, started once each in SCHEMA_ORDER to create their tables, and
# every 1.x and 2.0 table set aside. RESTORE_TABLES get their rows back (protocols, facilities, ...).
SERVICES="cce-matcher-service cce-protocol-service cce-step-sla-service cce-intelligence-service"
SCHEMA_ORDER="cce-protocol-service cce-matcher-service cce-intelligence-service"
CONSUMER_GROUP=cce-matcher-service
DROP_TABLES="protocol_definition action_definition trigger_index
  matcher_event_log protocol_instance protocol_instance_history step_instance step_instance_history
  step_sla_state_transition deviation intelligence_event_log facility receiver_adaptor
  destination_adaptor_mapping intelligence_delivery intelligence_delivery_audit_log notification_tracker
  compliance_event_log audit_log scheduler_lease scheduler_scan_cursor"
RESTORE_TABLES="protocol_definition action_definition trigger_index facility receiver_adaptor
  destination_adaptor_mapping intelligence_delivery intelligence_delivery_audit_log notification_tracker"

# The 2.0 data-pipeline ClickHouse is rebuilt with. Default: data-pipeline/ at the deploy-scripts root.
# DATA_PIPELINE_DIR=$HOME/<path>/data-pipeline
